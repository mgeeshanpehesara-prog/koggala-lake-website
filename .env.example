NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Booking email delivery via Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=bookings@example.com
# EMAIL_FROM must use a sender/domain verified in Resend. onboarding@resend.dev is sandbox-only and may only deliver to the Resend account email.
BOOKING_OWNER_EMAIL=boatsafariwithmalish@gmail.com
BUSINESS_NAME=Koggala Lake Boat Safari with Malish
# WhatsApp Cloud API owner notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Admin access — keep these private. Never commit .env.local.
ADMIN_EMAIL=your-private-admin-email
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_TOKEN=replace-with-a-long-random-secret
# Add these later for production database/payment/review integrations.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
MERCHANT_ID=
MERCHANT_SECRET=
NEXT_PUBLIC_PAYHERE_LIVE_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
